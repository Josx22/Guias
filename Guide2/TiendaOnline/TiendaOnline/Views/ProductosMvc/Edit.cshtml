@model TiendaOnline.Models.Producto

<h2>Modificar Producto</h2>

<form asp-action="Edit" method="post">
    <!-- El ID es invisible pero necesario para actualizar -->
    <input type="hidden" asp-for="ProductoId" />

    <label>Nombre:</label>
    <input asp-for="Nombre" class="form-control" />

    <label>Descripción:</label>
    <textarea asp-for="Descripcion" class="form-control"></textarea>

    <label>Precio:</label>
    <input asp-for="Precio" type="number" step="0.01" class="form-control" />

    <label>Categoría:</label>
    <select asp-for="CategoriaId" class="form-control">
        @foreach (var cat in (IEnumerable<TiendaOnline.Models.Categoria>)ViewBag.Categorias)
        {
            @if (cat.CategoriaId == Model.CategoriaId)
            {
                <option value="@cat.CategoriaId" selected>@cat.Nombre</option>
            }
            else
            {
                <option value="@cat.CategoriaId">@cat.Nombre</option>
            }
        }
    </select>

    <label>URL Imagen:</label>
    <input asp-for="UrlImagen" class="form-control" />

    <br />
    <button type="submit" class="btn btn-primary">Actualizar</button>
    <a asp-action="Index">Cancelar</a>
</form>
