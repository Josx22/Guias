@model IEnumerable<TiendaOnline.Models.Producto>

<h2>Lista de Productos</h2>
<p><a asp-action="Create" class="btn btn-primary">Nuevo Producto</a></p>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Categoría</th>
            <th>Imagen</th>
            <th>Opciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Precio.ToString("F2")</td>
                <td>@item.Categoria?.Nombre</td>
                <td><img src="@item.UrlImagen" width="50" /></td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ProductoId" class="btn btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.ProductoId" class="btn btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>